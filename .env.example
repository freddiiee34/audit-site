# --- Emails (Brevo) ---------------------------------------------------------
# Sans ces deux valeurs, aucun email n'est envoyé (l'outil fonctionne quand même).
# EXPEDITEUR_EMAIL doit être un expéditeur validé dans Brevo (idéalement sur le domaine du site).
BREVO_API_KEY=
EXPEDITEUR_EMAIL=
EXPEDITEUR_NOM=Simon Delrue

# Adresse qui reçoit les alertes : chaque nouvel audit et chaque demande de rendez-vous
NOTIF_EMAIL=simondelruepro@gmail.com

# --- Rédaction du rapport par l'IA (facultatif) ------------------------------
ANTHROPIC_API_KEY=
AUDIT_MODELE=claude-haiku-5-5

# --- Affichage -----------------------------------------------------------------
NOM_SERVICE=Audit de site
SIGNATURE=Simon Delrue, développeur web & IA à Lille
# Vide : direction « contrôle technique ». classique : première version
THEME=
TITRE_PRO=Développeur web & IA pour les PME
# Lien externe vers les réalisations (vide : la page /realisations du site) et lien LinkedIn
LIEN_REALISATIONS=
LIEN_LINKEDIN=https://www.linkedin.com/in/simon-delrue/
# Prix d'appel de l'offre de correction, ex. 290 €. Vide : « Devis gratuit, sans engagement »
OFFRE_PRIX=

# --- Mentions légales et confidentialité -------------------------------------------
EDITEUR_NOM=Simon Delrue
EDITEUR_STATUT=Entrepreneur individuel
EDITEUR_SIRET=984 352 666 00015
EDITEUR_ADRESSE=3B rue Marceau, 59290 Wasquehal
CONTACT_EMAIL=
CONTACT_TELEPHONE=
# Facultatif : lien d'agenda en ligne (Calendly, Cal.com), proposé après une demande de RDV
LIEN_AGENDA=
# Adresse publique du site, utilisée dans les liens des emails (ex. https://audit.simondelrue.fr)
URL_PUBLIQUE=

# --- Stockage et limites -------------------------------------------------------
AUDIT_DB=audits.db
AUDIT_SEL=remplace-moi-par-une-longue-chaine-aleatoire
AUDIT_LIMITE_EMAIL=3
AUDIT_LIMITE_IP=10
DERRIERE_PROXY=0
